# =====================================================================
# AI-Powered MERN Book Store — Shared Environment Template
# Copy to: server/.env  and  client/.env (only what each side needs)
# =====================================================================

# ---------- Core ----------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# ---------- Database ----------
MONGO_URI=mongodb://admin:admin@localhost:27017/ai_bookstore?authSource=admin

# ---------- Auth ----------
JWT_ACCESS_SECRET=replace_me_access
JWT_REFRESH_SECRET=replace_me_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_SALT_ROUNDS=12

# ---------- Email ----------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="AI Bookstore <no-reply@example.com>"

# ---------- File uploads ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
CHAT_RATE_LIMIT_MAX=30

# ---------- LLM / AI ----------
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800

# ---------- Embeddings / Recommendation system ----------
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
VECTOR_BACKEND=local            # local | pinecone | weaviate | atlas
VECTOR_INDEX=book_embeddings

# ---------- Payment (Stripe) ----------
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---------- Client (Vite) ----------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_CHAT_STREAMING=true
