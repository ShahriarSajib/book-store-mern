# server-only env (copy of root .env.example, trimmed)
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://admin:admin@localhost:27017/ai_bookstore?authSource=admin

JWT_ACCESS_SECRET=replace_me_access
JWT_REFRESH_SECRET=replace_me_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_SALT_ROUNDS=12

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
CHAT_RATE_LIMIT_MAX=30

LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800

EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
VECTOR_BACKEND=local
VECTOR_INDEX=book_embeddings

PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="AI Bookstore <no-reply@example.com>"
