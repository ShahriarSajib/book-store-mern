{
  "name": "ai-bookstore-server",
  "version": "0.1.0",
  "description": "AI-Powered MERN Book Store — Express API",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:books": "node scripts/seedBooks.js",
    "test": "jest --runInBand",
    "lint": "eslint \"src/**/*.js\"",
    "test:jobs": "jest tests/jobs.test.js --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.7.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "stripe": "^22.5.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "eslint": "^9.8.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
